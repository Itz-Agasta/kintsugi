# Gemini API key (research agent and correction drafts)
GEMINI_API_KEY=

# Cloudflare Workers AI (triage decision model)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# FalkorDB (local docker compose defaults)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# CLEF_MODEL=clef-flash

# Server (kintsugi serve)
# PORT=8080
# ALLOW_ORIGINS=http://localhost:5173
# RUN_PACE_MS=120
# REPAIR_PACE_MS=250
# SESSION_IDLE_MIN=60
# MAX_SESSIONS=20

# Dashboard deploy (just deploy-web): the Cloudflare account to deploy to
# CLOUDFLARE_ACCOUNT_ID=
